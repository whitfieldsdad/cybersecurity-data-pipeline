SET preserve_insertion_order = false;
SET temp_directory = '/var/tmp/duckdb';
SET memory_limit = '8GB';

CREATE OR REPLACE TABLE _cwe AS (
    SELECT * FROM read_json_auto('{{ data_dir }}/layers/silver/processed/mitre-cwe/weakness-catalog.json', maximum_object_size = 50000000) -- 50 MiB limit
);

CREATE OR REPLACE TABLE _weaknesses AS (
    SELECT
        'CWE-' || weakness.id AS cwe_id,
        weakness.*
    FROM (
        SELECT 
            UNNEST(weaknesses) AS weakness
        FROM _cwe
    )
);

CREATE OR REPLACE TABLE _groupings AS (
    SELECT
        g.*
    FROM (
        SELECT 
            UNNEST(groupings) AS g
        FROM _cwe
    )
);

CREATE OR REPLACE TABLE _views AS (
    SELECT
        v.*
    FROM (
        SELECT 
            UNNEST(views) AS v
        FROM _cwe
    )
);

CREATE OR REPLACE TABLE weaknesses_to_impacts AS (
    SELECT
        cwe_id,
        ARRAY_SORT(consequence.scope) AS scope,
        ARRAY_SORT(consequence.impact) AS impact,
        consequence.note AS note,
        consequence.likelihood AS likelihood
    FROM (
        SELECT
            cwe_id,
            UNNEST(common_consequences) AS consequence
        FROM _weaknesses
    )
    ORDER BY *
);

CREATE OR REPLACE TABLE weaknesses AS (
    SELECT 
        w.cwe_id,
        w."name",
        w.abstraction,
        w.structure,
        w."status",
        w."description",
        w.extended_description,
        w.technical_nuance,
        ARRAY_SORT(w.functional_areas) AS functional_areas,
        w.likelihood_of_exploitation,
        w.affected_resources,
        'Confidentiality' = ANY(w2i.scope) AS "impacts_confidentiality",
        'Integrity' = ANY(w2i.scope) AS "impacts_integrity",
        'Availability' = ANY(w2i.scope) AS "impacts_availability",
        'Other' = ANY(w2i.scope) AS "impacts_other"
    FROM _weaknesses w
    JOIN weaknesses_to_impacts w2i ON w.cwe_id = w2i.cwe_id
    GROUP BY *
    ORDER BY *
);

CREATE OR REPLACE TABLE groupings AS (
    SELECT
        id,
        "name",
        "description",
        "status"
    FROM _groupings
    ORDER BY id
);

CREATE OR REPLACE TABLE views AS (
    SELECT
        id,
        "type",
        "name",
        "objective",
        "status",
        stakeholder.type AS stakeholder_type,
        stakeholder.description AS stakeholder_description
    FROM (
        SELECT
            id,
            "type",
            "name",
            "objective",
            "status",
            UNNEST(audience) AS stakeholder
        FROM _views
    )
    ORDER BY id
);

CREATE OR REPLACE TABLE groupings_to_weaknesses AS (
    SELECT
        grouping_id,
        ref.view_id,
        'CWE-' || ref.weakness_id AS cwe_id
    FROM (
        SELECT
            id AS grouping_id,
            UNNEST(members) AS ref
        FROM _groupings
    )
);

CREATE OR REPLACE TABLE weaknesses_to_techniques AS (
    SELECT
        cwe_id,
        'CAPEC-' || capec_id AS capec_id
    FROM (
        SELECT 
            cwe_id,
            UNNEST(related_attack_patterns) AS capec_id
        FROM _weaknesses
    )
    ORDER BY *
);

CREATE OR REPLACE TABLE weaknesses_to_vulnerabilities AS (
    SELECT
        cwe_id,
        example.reference AS cve_id
    FROM (
        SELECT 
            cwe_id,
            UNNEST(observed_examples) AS example
        FROM _weaknesses
    )
    WHERE example.reference LIKE 'CVE-%'
    ORDER BY cve_id DESC, cwe_id ASC
);

COPY weaknesses TO '{{ data_dir }}/layers/silver/relational/mitre-cwe/weaknesses.parquet';
COPY groupings TO '{{ data_dir }}/layers/silver/relational/mitre-cwe/groupings.parquet';
COPY views TO '{{ data_dir }}/layers/silver/relational/mitre-cwe/views.parquet';

COPY groupings_to_weaknesses TO '{{ data_dir }}/layers/silver/relational/mitre-cwe/groupings-to-weaknesses.parquet';
COPY weaknesses_to_techniques TO '{{ data_dir }}/layers/silver/relational/mitre-cwe/weaknesses-to-techniques.parquet';
COPY weaknesses_to_vulnerabilities TO '{{ data_dir }}/layers/silver/relational/mitre-cwe/weaknesses-to-vulnerabilities.parquet';
