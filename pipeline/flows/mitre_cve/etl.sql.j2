SET preserve_insertion_order = false;
SET memory_limit = '8GB';

-- CVEs (raw)
CREATE OR REPLACE TEMP TABLE _cves AS (
    SELECT
        *
    FROM read_json_auto(
        '{{ data_dir }}/layers/bronze/git/CVEProject/cvelistV5/cves/*/*/CVE-*.json',
        maximum_sample_files = -1
    )
);

COPY _cves TO '{{ data_dir }}/layers/silver/processed/mitre-cve/cves.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY _cves TO '{{ data_dir }}/layers/silver/processed/mitre-cve/cves.jsonl.gz' (FORMAT json, COMPRESSION gzip);

CREATE OR REPLACE TABLE cves AS (
    SELECT
        cveMetadata.cveId AS id,
        list_max(
            list_transform(
                list_filter(containers.cna.descriptions, lambda d: d.lang IN ('en', 'en-US')),
                lambda d: d.value
            )
        ) AS "description",
        cveMetadata.state,
        cveMetadata.dateUpdated AS date_updated,
        cveMetadata.datePublished AS date_published,
        cveMetadata.dateReserved AS date_reserved
    FROM _cves
);

-- CVEs to CVSS vectors
-- * Includes CVSS 2, 3, 3.1, 4 vectors
CREATE OR REPLACE TABLE cves_to_cvss_vectors AS (
    SELECT
        cve_id,
        m.cvssV2_0.vectorString AS cvss_2_0_vector,
        m.cvssV3_0.vectorString AS cvss_3_0_vector,
        m.cvssV3_1.vectorString AS cvss_3_1_vector,
        m.cvssV4_0.vectorString AS cvss_4_0_vector
    FROM (
        SELECT
            cveMetadata.cveId AS cve_id,
            UNNEST(containers.cna.metrics) AS m
        FROM _cves
    )
    WHERE COALESCE(cvss_2_0_vector, cvss_3_0_vector, cvss_3_1_vector, cvss_4_0_vector) IS NOT NULL
);


-- CVEs to CWEs (i.e. vulnerabilities to weaknesses)
-- * Flatten problemTypes -> descriptions -> cweId in one pass and UNNEST once
CREATE OR REPLACE TABLE cves_to_cwes AS (
    SELECT
        cve_id,
        cwe_id
    FROM (
        SELECT
            cveMetadata.cveId AS cve_id,
            UNNEST(flatten([[d.cweId FOR d IN p.descriptions] FOR p IN containers.cna.problemTypes])) AS cwe_id
        FROM _cves
    )
    WHERE cwe_id IS NOT NULL
);


-- CVEs to CISA Stakeholder-Specific Vulnerability Categorization (SSVC)
CREATE OR REPLACE TABLE cves_to_ssvc AS (
    WITH ssvc_metrics AS (
        SELECT
            cveMetadata.cveId AS cve_id,
            adp_container.providerMetadata.orgId AS org_id,
            metric.other.content.timestamp AS "timestamp",
            metric.other.content.role AS ssvc_role,
            metric.other.content.version AS ssvc_version,
            metric.other.content.options AS options
        FROM _cves
        CROSS JOIN UNNEST(containers.adp) AS adp(adp_container)
        CROSS JOIN UNNEST(adp_container.metrics) AS m(metric)
        WHERE metric.other."type" = 'ssvc'
    )
    SELECT
        cve_id,
        org_id,
        "timestamp",
        ssvc_role,
        ssvc_version,
        MAX(list_max([o."Exploitation" FOR o IN options])) AS exploitation,
        MAX(list_max([o."Automatable" FOR o IN options])) AS automatable,
        MAX(list_max([o."Technical Impact" FOR o IN options])) AS technical_impact
    FROM ssvc_metrics
    WHERE len(options) > 0  -- matches the old CROSS JOIN UNNEST(options), which dropped NULL/empty option lists
    GROUP BY cve_id, org_id, "timestamp", ssvc_role, ssvc_version
);


-- CVEs to Certificate Naming Authorities (CNAs)
CREATE OR REPLACE TABLE cves_to_cnas AS (
    SELECT DISTINCT
        cveMetadata.cveId AS cve_id,
        cveMetadata.assignerOrgId AS "cna_id"
    FROM _cves
);


-- Certificate Naming Authorities (CNAs)
CREATE OR REPLACE TABLE cna_organizations AS (
    SELECT DISTINCT
        cveMetadata.assignerOrgId AS "id",
        cveMetadata.assignerShortName AS "name"
    FROM _cves
);


-- Authorized Data Publishers (ADP)
CREATE OR REPLACE TABLE adp_organizations AS (
    SELECT DISTINCT
        UNNEST([{'id': a.providerMetadata.orgId, 'name': a.providerMetadata.shortName} FOR a IN containers.adp], recursive := true)
    FROM _cves
);


-- CVEs to external references
CREATE OR REPLACE TABLE cves_to_external_references AS (
    SELECT
        cve_id,
        "name",
        "url",
        regexp_extract("url", 'https?://([^/]+)', 1) AS domain,
        tags
    FROM (
        SELECT
            cve_id,
            ref.name,
            ref.url,
            ref.tags
        FROM (
            SELECT
                cveMetadata.cveId AS cve_id,
                UNNEST(containers.cna."references") AS ref
            FROM _cves
        )
        UNION ALL BY NAME
        SELECT
            cve_id,
            ref.name,
            ref.url,
            ref.tags
        FROM (
            SELECT
                cveMetadata.cveId AS cve_id,
                UNNEST(flatten([a."references" FOR a IN containers.adp])) AS ref
            FROM _cves
        )
    )
);


-- CVEs to Metasploit modules
CREATE OR REPLACE TABLE cves_to_metasploit_modules AS (
    SELECT
        cve_id,
        "url",
        module
    FROM (
        SELECT
            cve_id,
            "url",
            regexp_extract("url", '(?i)(?:^|/)modules/((?:exploits?|auxiliaries|posts?|payloads?|encoders?|nops?)/.+?)(?:\\.(?:rb|pm))?(?:[?#]|$)', 1) AS module
        FROM cves_to_external_references
        WHERE "url" ILIKE '%modules/%'
    )
    WHERE module != ''
);


COPY (SELECT * FROM cves ORDER BY id DESC) TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cves_to_cvss_vectors ORDER BY cve_id DESC) TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves-to-cvss-vectors.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cves_to_cwes ORDER BY cve_id DESC, cwe_id ASC) TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves-to-cwes.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cves_to_ssvc ORDER BY cve_id DESC) TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves-to-ssvc.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cves_to_cnas ORDER BY cve_id DESC) TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves-to-cnas.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cna_organizations ORDER BY "name") TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cna-organizations.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM adp_organizations ORDER BY "name") TO '{{ data_dir }}/layers/silver/relational/mitre-cve/adp-organizations.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cves_to_external_references ORDER BY cve_id DESC, "name") TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves-to-external-references.parquet' (FORMAT parquet, COMPRESSION snappy);
COPY (SELECT * FROM cves_to_metasploit_modules) TO '{{ data_dir }}/layers/silver/relational/mitre-cve/cves-to-metasploit-modules.parquet' (FORMAT parquet, COMPRESSION snappy);