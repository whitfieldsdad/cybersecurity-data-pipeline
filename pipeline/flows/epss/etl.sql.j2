SET preserve_insertion_order = false;
SET temp_directory = '/var/tmp/duckdb';
SET memory_limit = '8GB';

-- Ingest EPSS scores from empiricalsec/epss_scores
COPY (
    SELECT
        substr("filename", -17, 10)::DATE AS "date",
        cve,
        epss,
        percentile
    FROM read_csv(
        '{{ data_dir }}/layers/bronze/git/empiricalsec/epss_scores/202*/epss_scores-*-*-*.csv.gz',
        header = true,
        auto_detect = false,
        strict_mode = false,
        null_padding=true,
        columns = {'cve': 'VARCHAR', 'epss': 'FLOAT', 'percentile': 'FLOAT'},
        filename = true,
        comment = '#'
    )
)
TO '{{ data_dir }}/layers/silver/hive/epss-scores'
(
    FORMAT PARQUET,
    PARTITION_BY ("date"),
    OVERWRITE true,
    COMPRESSION SNAPPY
);

-- EPSS score changelog
-- * Tracks day to day changes in `epss` and `percentile`
COPY (
    WITH timeline AS (
        SELECT
            "date",
            cve,
            epss,
            percentile,
            lag("date") OVER epss_history AS previous_date,
            lag(epss) OVER epss_history AS previous_epss,
            lag(percentile) OVER epss_history AS previous_percentile
        FROM read_parquet(
            '{{ data_dir }}/layers/silver/hive/epss-scores/*/*.parquet',
            hive_partitioning = true
        )
        WINDOW epss_history AS (PARTITION BY cve ORDER BY "date" ASC)
    )
    SELECT
        "date",
        cve,
        epss,
        percentile,
        previous_date,
        previous_epss,
        epss - previous_epss AS epss_change,
        100.0 * (epss - previous_epss) / nullif(previous_epss, 0) AS epss_percent_change,
        previous_percentile,
        percentile - previous_percentile AS percentile_change,
        100.0 * (percentile - previous_percentile) / nullif(previous_percentile, 0) AS percentile_percent_change
    FROM timeline
)
TO '{{ data_dir }}/layers/silver/relational/epss-scores/epss-score-changelog.parquet'
(FORMAT PARQUET, COMPRESSION SNAPPY);

-- EPSS scores
-- * Only includes records where `epss` or `percentile` changed by at least 1%
COPY (
    SELECT
        "date",
        cve,
        epss,
        percentile
    FROM read_parquet(
        '{{ data_dir }}/layers/silver/hive/epss-scores/*/*.parquet',
        hive_partitioning = true
    )
)
TO '{{ data_dir }}/layers/silver/relational/epss-scores/epss-scores.parquet'
(FORMAT PARQUET, COMPRESSION SNAPPY);

-- EPSS score history
-- * Includes current, earliest, minimum, and maximum values of `epss` and `percentile` for each `cve`
COPY (
    SELECT
        MAX("date") AS "date",
        cve,
        arg_max(epss, "date") AS epss,
        arg_max(percentile, "date") AS percentile,
        MIN("date") AS earliest_date,
        arg_min(epss, "date") AS earliest_epss,
        arg_min("date", epss) AS min_epss_date,
        MIN(epss) AS min_epss,
        arg_max("date", epss) AS max_epss_date,
        MAX(epss) AS max_epss,
        arg_min("date", percentile) AS earliest_percentile_date,
        arg_min(percentile, "date") AS earliest_percentile,
        arg_min("date", percentile) AS min_percentile_date,
        MIN(percentile) AS min_percentile,
        arg_max("date", percentile) AS max_percentile_date,
        arg_max(percentile, "date") AS max_percentile,
        MAX("date") - MIN("date") AS total_dates,
        MAX(epss) - MIN(epss) AS epss_range,
        MAX(percentile) - MIN(percentile) AS percentile_range
    FROM read_parquet(
        '{{ data_dir }}/layers/silver/hive/epss-scores/*/*.parquet',
        hive_partitioning = true
    )
    GROUP BY cve
    ORDER BY cve DESC
)
TO '{{ data_dir }}/layers/silver/relational/epss-scores/epss-score-history.parquet'
(FORMAT PARQUET, COMPRESSION SNAPPY);